-x* drivewire-rs startup: NitrOS-9 + WiFi telnet bridgeecho NitrOS-9 Level 2 V3.3.0 - Coco3FPGA - via drivewire-rslink shellload utilpak1merge /dd/sys/stdfonts /dd/sys/stdptrs /dd/sys/stdpats_2 /dd/sys/stdpats_4 /dd/sys/stdpats_16shell i=/w&shell i=/w&* dw-attach login terminalsiniz /N1iniz /N2iniz /N3xmode /N1 eko=1 alf=1 pau=0xmode /N2 eko=1 alf=1 pau=0xmode /N3 eko=1 alf=1 pau=0tsmon /N1&tsmon /N2&tsmon /N3&* Three wtbridge pseudo-terminals - one per simultaneous TCP clientiniz /wtiniz /wt1iniz /wt2tsmon /wt&tsmon /wt1&tsmon /wt2&* ESP into TCP server mode on port 23, then start wtbridgewifi ATE0wifi AT+CIPMUX=1wifi AT+CIPSERVER=1,23wtbridge&date -t